{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(./abm check:*)",
      "Bash(./abm doctor:*)",
      "Bash(./abm okf validate:*)",
      "Bash(./abm ads-check:*)",
      "Bash(./abm links:*)",
      "Bash(./abm token-budget:*)",
      "Bash(./abm lint:*)",
      "Bash(./abm pending list:*)",
      "Bash(./abm methodology classify:*)",
      "Bash(./abm agent-conformance:*)",
      "Bash(./abm sync --check:*)",
      "Bash(./abm tokens report:*)",
      "Bash(./abm tokens attest:*)",
      "Bash(./abm tokens budget:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(ls:*)",
      "Bash(wc:*)"
    ],
    "ask": [
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(rm:*)",
      "Bash(mv:*)",
      "Bash(npm publish:*)",
      "Bash(pip install:*)",
      "Bash(npm install:*)",
      "Bash(curl:*)",
      "Bash(wget:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./secrets/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf /:*)",
      "Bash(sudo:*)"
    ]
  }
}
