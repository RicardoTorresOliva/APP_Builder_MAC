# Variables del panel de ventas (copia a .env o expórtalas; nunca subas valores reales).
# Ruta de la base SQLite (por defecto data/panel.db).
PANEL_VENTAS_DB=
# Moneda ISO 4217 para mostrar montos (por defecto USD).
PANEL_VENTAS_MONEDA=
# Contraseña para los usuarios demo al sembrar. Vacía: se genera una aleatoria y se muestra una sola vez.
PANEL_VENTAS_DEMO_PASSWORD=
# Log de auditoría de acciones de agentes (por defecto ops/audit/agent-actions.jsonl).
PANEL_VENTAS_AUDIT_LOG=
